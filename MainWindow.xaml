<Window x:Class="drugie_okno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:drugie_okno"
        mc:Ignorable="d"
        Title="Moja aplikacja z agentem" Height="450" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="LightGreen">
    <StackPanel Margin="20">
        <TextBlock Text="Witaj w mojej aplikacji!" FontSize="30" />
        <TextBlock Text="Projekt WPF wykonany z pomocą agenta AI" Margin="0,10,0,0" />
        <TextBox Margin="0,15,0,0" />
        <Button Content="Kliknij mnie" HorizontalAlignment="Left" Margin="0,15,0,0" Background="DarkGreen" Foreground="White" Click="Button_Click" />
    </StackPanel>
</Window>
